# Contrôleur de la serre (docs/06 §4) : sécurité, règles, risque, prévision, décisions.
[Unit]
Description=SerreIA - contrôleur (niveaux 0 à 2, décisions, commandes)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=notify
User=serre
WorkingDirectory=/home/serre/SerreIA
ExecStart=/home/serre/SerreIA/.venv/bin/python -m edge.controller
Restart=always
RestartSec=10
WatchdogSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
