    "type": "pixel_art",
    "perspective": "top_down_3_4",
    "lighting": "top_left",
    "outline_color": "#49352B",
    "max_colors": 32,
    "background": "transparent",
    "anti_aliasing": false,
    "palette": {
      "leaf_green": "#5D8C45",
      "dark_green": "#315B35",
      "soil_brown": "#805333",
      "wood_brown": "#A66E43",
      "terracotta": "#C76F4F",
      "cream": "#F3E5C8",
      "water_blue": "#559BC4",
      "flower_yellow": "#E8C957",
      "alert_red": "#D94F45",
      "led_purple": "#D45BE8"
    }
  },
  "modele": {
    "note": "links to the data model (docs/09): read by tools/construire_atlas.py to build frontend/src/game/catalogue.gen.json",
    "sante": { "sain": "healthy", "a_surveiller": "yellowing", "malade": "sick" },
    "stades": ["semis", "croissance", "floraison", "fructification", "recolte"]
  },
  "grid": {
    "tile_size": [16, 16],
    "character_size": [16, 24],
    "large_object_sizes": [
