          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('$__interval', ts) AS time, type AS metric, avg(valeur) AS valeur\nFROM mesure\nWHERE $__timeFilter(ts) AND zone = '$zone' AND type IN ('temperature', 'temp_eau') AND qualite <> 'erreur'\nGROUP BY 1, 2 ORDER BY 1"
