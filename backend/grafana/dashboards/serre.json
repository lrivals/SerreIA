          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, actionneur AS metric,\n       CASE action WHEN 'off' THEN 0 WHEN 'on' THEN 100 ELSE valeur END AS valeur\nFROM etat_actionneur\nWHERE $__timeFilter(ts) AND zone = '$zone'\nORDER BY 1"
